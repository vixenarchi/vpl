#!/usr/bin/env bash
# Publish one app of the suite. There is nothing to build: the app already is
# the files, and the database lives at Supabase. So this stages what a browser
# needs — the app, plus a copy of the shared shell — and hands that folder to
# Cloudflare Pages.
#
#   ./deploy              # publish apps/vn to the project named below
#   ./deploy vn           # the same, spelled out
#   ./deploy vn --dry-run # only show what would be uploaded
#   APP_PROJECT="vpl-vi" ./deploy vi    # a different Pages project
#
# One Pages project per app, one custom domain per project. `vn` is `vpl`,
# because it was the first and its domain already points there.
#
# First time on this machine:  npx wrangler login
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
APP=""
DRY=""
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    -*) echo "unknown flag: $a" >&2; exit 2 ;;
    *) APP="$a" ;;
  esac
done
APP=${APP:-vn}
SRC="$ROOT/apps/$APP"
[ -d "$SRC" ] || { echo "no such app: $APP (have: $(ls "$ROOT/apps" 2>/dev/null | tr '\n' ' '))" >&2; exit 2; }

# first app keeps the name it already has on Cloudflare
if [ "$APP" = vn ]; then PROJECT=${PROJECT:-vpl}; else PROJECT=${PROJECT:-vpl-$APP}; fi
BRANCH=${BRANCH:-main}

# the shared look, copied in so the app can be published on its own
"$ROOT/tools/stage.sh" "$APP"

# everything a browser asks for, and nothing else: no tests, no migrations,
# no dev server, no notes about any of it.
STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

[ -f "$SRC/index.html" ] || { echo "missing apps/$APP/index.html" >&2; exit 1; }
# An app is its files. Everything at the app root ships, except the things that
# are notes for a person rather than bytes for a browser — and a file left out by
# accident is a 404 that looks exactly like a bug in the app, so say it out loud.
for f in "$SRC"/* "$SRC"/.[!.]*; do
  [ -f "$f" ] || continue
  b=$(basename "$f")
  case "$b" in
    *.md|*.env|config.local.js.example) echo "note: kept out of the deploy: $b"; continue ;;
    .*) [ "$b" = ".well-known" ] || { echo "note: kept out of the deploy: $b"; continue; } ;;
  esac
  cp "$f" "$STAGE/"
done
for d in lib icons vendor functions assets img fonts .well-known; do
  [ -d "$SRC/$d" ] && cp -r "$SRC/$d" "$STAGE/"
done

# The front door is one page with no JavaScript: it wants the shell's tokens and
# nothing else. Shipping eight modules nobody loads would be weight with no
# purpose, and the house rule is that a page carries what it uses.
if [ "$APP" = www ] && [ -d "$STAGE/vendor" ]; then
  find "$STAGE/vendor" -name '*.js' -delete
fi

# the anon key is public on purpose — RLS is the lock, not the key. But a
# service-role key would be fatal, so refuse to publish one by accident.
if grep -q "service_role" "$STAGE"/*.js 2>/dev/null; then
  echo "refusing to deploy: a service_role key is in the client" >&2
  exit 1
fi

SIZE=$(du -sk "$STAGE" | cut -f1)
echo "staging apps/$APP → $PROJECT, $SIZE KB:"
(cd "$STAGE" && find . -type f | sort | sed 's/^\./  /')

if [ -n "$DRY" ]; then
  echo "dry run: nothing uploaded"
  exit 0
fi

# `wrangler whoami` exits 0 even when it is not logged in, so read the answer
# rather than the exit code.
WHO=$(npx --yes wrangler whoami 2>&1 || true)
if ! grep -q "associated with the email" <<<"$WHO"; then
  cat >&2 <<'EOF'

not signed in to Cloudflare. Run once:

    npx wrangler login

That opens a browser; after it, ./deploy works. There is no API token to paste
and nothing to install — Pages is free at this size.
EOF
  exit 1
fi

# Run from inside the stage: wrangler looks for `functions/` relative to the
# working directory, not relative to the argument, so deploying from the repo
# root would silently ship the assets without the function.
(cd "$STAGE" && npx --yes wrangler pages deploy . --project-name "$PROJECT" --branch "$BRANCH")
