# your project url and anon key. The anon key is public by design (RLS is the
# lock, not the key), but the file is yours: copy config.example.js and fill it in.
config.local.js
.env.local
*.env

# supabase CLI scratch
supabase/.temp/
supabase/.branches/

# the shared shell, copied into an app by ./stage — never committed twice
apps/*/vendor/

# test deps and artefacts
apps/*/test/node_modules/
apps/*/test/package-lock.json
apps/*/test/*.png

# os
.DS_Store

# wrangler writes its own cache where it is run
.wrangler/
